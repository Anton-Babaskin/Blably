          "t": "Тут, там, налево",
          "steps": [
            {"k":"learn","t":"Тут и там","b":"<b>bu, şu, o</b> — это, вон то, то (далеко). От них: <b>burada</b> — здесь, <b>şurada</b> — вон там, <b>orada</b> — там.","ex":[["burada","здесь"],["şurada","вон там"],["orada","там"],["buraya","сюда"],["oraya","туда"]]},
            {"k":"learn","t":"Направления","b":"","ex":[["sağ, sol","право, лево"],["Sağa dön.","Поверни направо."],["Sola dön.","Поверни налево."],["Düz git.","Иди / езжай прямо."],["köşede","на углу"],["yakın, uzak","близко, далеко"]]},
            {"k":"match","p":[["sağ","право"],["sol","лево"],["düz","прямо"],["yakın","близко"],["uzak","далеко"]]},
            {"k":"mc","q":"Таксисту: «Остановите здесь». Что сказать?","o":["Burada durun.","Orada durun.","Buraya durun.","Sağa durun."]},
            {"k":"mc","q":"<b>Düz gidin, sonra sola dönün.</b>","o":["Прямо, потом налево","Налево, потом прямо","Направо, потом прямо","Прямо, потом направо"],"why":null,"say":"Düz gidin, sonra sola dönün"},
            {"k":"build","ru":"Поверни направо.","a":"Sağa dön.","x":["Sola","git"]},
            {"k":"build","ru":"Это близко?","a":"Yakın mı?","x":["uzak","Burada"]}
          ]
        },
